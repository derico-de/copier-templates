"""Tests for {{ view_class_name }} view."""
import pytest

{%- if not view_test_use_site_root | default(false) %}
from plone import api
{%- endif %}
from plone.app.testing import setRoles
from plone.app.testing import TEST_USER_ID
from zope.component import getMultiAdapter
from zope.publisher.browser import TestRequest

from {{ package_name }}.testing import INTEGRATION_TESTING
{%- if view_marker %}
from {{ package_name }}.views.{{ view_module }} import I{{ view_class_name }}
{%- endif %}


class TestView{{ view_class_name }}:
    """Test {{ view_class_name }} view."""

    layer = INTEGRATION_TESTING

    @pytest.fixture(autouse=True)
    def _setup(self, integration):
        self.portal = integration["portal"]
        setRoles(self.portal, TEST_USER_ID, ["Manager"])
{%- if view_test_use_site_root | default(false) %}
        # View is registered for the Plone site root.
        self.context = self.portal
{%- else %}
        self.context = api.content.create(
            container=self.portal,
            type="{{ view_test_type | default('Document') }}",
            id="{{ view_test_id | default('test-document') }}",
            title="{{ view_test_title | default('Test Document') }}",
        )
{%- endif %}

    def test_view_registered(self):
        """Test view is registered."""
        request = TestRequest()
        view = getMultiAdapter(
            (self.context, request),
            name="{{ view_name }}",
        )
        assert view is not None

    def test_view_name(self):
        """Test view __name__."""
        request = TestRequest()
        view = getMultiAdapter(
            (self.context, request),
            name="{{ view_name }}",
        )
        assert view.__name__ == "{{ view_name }}"
{%- if view_marker %}

    def test_view_marker_interface(self):
        """Test view provides marker interface."""
        request = TestRequest()
        view = getMultiAdapter(
            (self.context, request),
            name="{{ view_name }}",
        )
        assert I{{ view_class_name }}.providedBy(view)
{%- endif %}
