[project]
name = {{ package_name | toml_string }}
version = "1.0.0a1"
description = {{ package_description | toml_string }}
readme = "README.md"
requires-python = ">=3.10"
license = {text = "GPL-2.0-or-later"}
authors = [
    {name = {{ author_name | toml_string }}, email = {{ author_email | toml_string }}}
]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Environment :: Web Environment",
    "Framework :: Plone",
    "Framework :: Plone :: Addon",
    {{ ("Framework :: Plone :: " ~ plone_version) | toml_string }},
    "License :: OSI Approved :: GNU General Public License v2 or later (GPLv2+)",
    "Operating System :: OS Independent",
    "Programming Language :: Python",
    "Programming Language :: Python :: 3.10",
    "Programming Language :: Python :: 3.11",
    "Programming Language :: Python :: 3.12",
]
keywords = ["Plone", "CMS"]

dependencies = [
    {{ ("Plone>=" ~ plone_version) | toml_string }},
    "setuptools<81",
{%- if is_headless %}
    "plone.restapi",
{%- endif %}
]

[project.optional-dependencies]
test = [
    "pytest",
    "pytest-cov",
    "pytest-plone>=0.5.0",
    "plone.app.testing",
    "plone.testing",
]

[project.urls]
Homepage = {{ ("https://github.com/" ~ github_organization ~ "/" ~ package_name) | toml_string }}
Documentation = {{ ("https://github.com/" ~ github_organization ~ "/" ~ package_name) | toml_string }}
Repository = {{ ("https://github.com/" ~ github_organization ~ "/" ~ package_name ~ ".git") | toml_string }}
Issues = {{ ("https://github.com/" ~ github_organization ~ "/" ~ package_name ~ "/issues") | toml_string }}

[project.entry-points."z3c.autoinclude.plugin"]
target = "plone"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = [{{ ("src/" ~ package_folder.split('/')[0]) | toml_string }}]

[tool.plone.backend_addon.settings]
package_name = {{ package_name | toml_string }}
package_title = {{ package_title | toml_string }}
package_description = {{ package_description | toml_string }}
package_folder = {{ package_folder | toml_string }}
plone_version = {{ plone_version | toml_string }}
is_headless = {{ is_headless | lower }}
author_name = {{ author_name | toml_string }}
author_email = {{ author_email | toml_string }}

[tool.plone.backend_addon.settings.subtemplates]
content_types = []
behaviors = []
services = []

[tool.pytest.ini_options]
testpaths = [{{ ("src/" ~ package_folder ~ "/tests") | toml_string }}]
python_files = ["test_*.py"]

[tool.coverage.run]
source = [{{ package_name | toml_string }}]
omit = ["*/tests/*"]

[tool.ruff]
line-length = 100
target-version = "py310"

[tool.ruff.lint]
select = [
    "E",    # pycodestyle errors
    "F",    # pyflakes
    "I",    # isort
    "W",    # pycodestyle warnings
    "C90",  # mccabe complexity
    "B",    # bugbear
    "S",    # bandit (security)
    "UP",   # pyupgrade
    "SIM",  # simplify
    "PGH",  # pygrep-hooks
]
ignore = ["E731"]

[tool.ruff.lint.per-file-ignores]
"src/**/tests/**" = ["S101"]
# Locale update helper shells out to fixed translation tools (i18ndude/msginit).
"src/**/locales/update.py" = ["S603", "S607"]

[tool.ruff.lint.isort]
# Match the single-import-per-line, alphabetical layout the templates emit.
force-single-line = true
order-by-type = false
lines-after-imports = 2
known-first-party = [{{ package_name.split('.')[0] | toml_string }}]

[tool.ruff.format]
preview = true
