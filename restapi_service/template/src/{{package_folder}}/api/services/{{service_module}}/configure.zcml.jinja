<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone">
{% if expandable %}
  <adapter
      factory=".get.{{ service_class }}"
      name="{{ service_module }}"
      />
{% endif %}
{%- if http_get %}
  <plone:service
      method="GET"
      for="{{ service_for_resolved }}"
      factory=".get.{{ service_class }}Get"
      name="{{ service_endpoint }}"
      permission="zope2.View"
      />
{% endif %}
{%- if http_post %}
  <plone:service
      method="POST"
      for="{{ service_for_resolved }}"
      factory=".post.{{ service_class }}Post"
      name="{{ service_endpoint }}"
      permission="cmf.ModifyPortalContent"
      />
{% endif %}
{%- if http_patch %}
  <plone:service
      method="PATCH"
      for="{{ service_for_resolved }}"
      factory=".patch.{{ service_class }}Patch"
      name="{{ service_endpoint }}"
      permission="cmf.ModifyPortalContent"
      />
{% endif %}
{%- if http_delete %}
  <plone:service
      method="DELETE"
      for="{{ service_for_resolved }}"
      factory=".delete.{{ service_class }}Delete"
      name="{{ service_endpoint }}"
      permission="cmf.ModifyPortalContent"
      />
{% endif %}
</configure>
