from zope.component import adapter
from zope.interface import Interface
from zope.interface import implementer


@implementer(IExpandableElement)
@adapter(Interface, Interface)
class {{ service_class }}:
    """Expandable element for {{ service_endpoint }}.

    This adapter enriches existing REST API responses (e.g. content GET)
    when the consumer requests ``?expand={{ service_module }}``.
    """

    def __init__(self, context, request):
        self.context = context
        self.request = request

    def __call__(self, expand=False):
        result = {
            "{{ service_module }}": {
                "@id": f"{self.context.absolute_url()}/{{ service_endpoint }}",
            },
        }
        if not expand:
            return result

        # Populate the full response when expanded
        result["{{ service_module }}"].update(
            {
                "items": [],
                # Add your expanded data here
            }
        )
        return result
