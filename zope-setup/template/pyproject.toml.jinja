[project]
name = {{ project_name | toml_string }}
version = "1.0.0"
description = {{ project_description | toml_string }}
readme = "README.md"
requires-python = ">=3.10"
license = {text = "GPL-2.0-or-later"}
authors = [
    {name = {{ author_name | toml_string }}, email = {{ author_email | toml_string }}}
]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Framework :: Plone",
    {{ ("Framework :: Plone :: " ~ plone_version.split('.')[0] ~ "." ~ plone_version.split('.')[1]) | toml_string }},
    "License :: OSI Approved :: GNU General Public License v2 or later (GPLv2+)",
    "Programming Language :: Python",
    "Programming Language :: Python :: 3.10",
    "Programming Language :: Python :: 3.11",
    "Programming Language :: Python :: 3.12",
]

dependencies = [
    {{ distribution | toml_string }},
    {{ ("Plone==" ~ plone_version) | toml_string }},
{%- if db_storage == "relstorage" %}
    "RelStorage[postgresql]",
{%- endif %}
{%- if db_storage == "zeo" %}
    "ZEO",
{%- endif %}
]

[project.optional-dependencies]
test = [
    "pytest",
    "pytest-plone>=0.5.0",
    "plone.app.testing",
    "plone.testing",
]

[dependency-groups]
dev = [
    "invoke",
    "watchdog",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src"]

[tool.plone.project.settings]
plone_version = {{ plone_version | toml_string }}
distribution = {{ distribution | toml_string }}
db_storage = {{ db_storage | toml_string }}
created_at = {{ current_date | toml_string }}
instances = []

[tool.uv]
constraint-dependencies = []

[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = ["test_*.py"]

[tool.ruff]
line-length = 100
target-version = "py310"

[tool.ruff.lint]
select = [
    "E",    # pycodestyle errors
    "F",    # pyflakes
    "I",    # isort
    "W",    # pycodestyle warnings
    "C90",  # mccabe complexity
    "B",    # bugbear
    "S",    # bandit (security)
    "UP",   # pyupgrade
    "SIM",  # simplify
    "PGH",  # pygrep-hooks
]
ignore = ["E731"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"]

[tool.ruff.lint.isort]
known-first-party = [{{ project_name.split('.')[0] | toml_string }}]

[tool.ruff.format]
preview = true
